# Ubuntu 22.04 LTS (Jammy Jellyfish)
# Python 3.10.6
FROM ubuntu:22.04

# Install common tools
# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    jq \
    libxml2-dev \
    libxslt-dev \
    rsync \
    vim && \
    rm -rf /var/lib/apt/lists/*

# Set up runtime environment
ARG USERNAME=ubuntu
RUN id -u 1000 >/dev/null 2>&1 || useradd -m -u 1000 ${USERNAME}
USER ${USERNAME}
ENV PATH="/home/${USERNAME}/.local/bin:$PATH"
RUN mkdir -p /home/${USERNAME}/runtime
WORKDIR /home/${USERNAME}/runtime

# Install uv
ARG UV_VERSION
RUN /bin/bash -c "curl -LsSf https://astral.sh/uv/${UV_VERSION}/install.sh | sh && uv --version"

# Set up virtual environment and install PyPI dependencies
COPY --chown=${USERNAME}:${USERNAME} pyproject.toml ./
COPY --chown=${USERNAME}:${USERNAME} uv.lock ./
ARG DEV_MODE
RUN if [ "_${DEV_MODE}" = "_true" ]; then \
    uv sync --no-install-project --extra ardupilot; \
    else \
    uv sync --no-install-project --no-dev --extra ardupilot; \
    fi

# Expose MCP server port
ARG MCP_SERVER_PORT
EXPOSE ${MCP_SERVER_PORT}

# Configure Jupyter Lab host and port
ARG JUPYTER_HOST
ARG JUPYTER_PORT
RUN if [ "_${DEV_MODE}" = "_true" ]; then \
    uv run --no-sync jupyter lab --generate-config && \
    CONFIG_FILE="/home/${USERNAME}/.jupyter/jupyter_lab_config.py" && \
    echo "c.ServerApp.ip = '${JUPYTER_HOST}'" >> "${CONFIG_FILE}" && \
    echo "c.ServerApp.port = ${JUPYTER_PORT}" >> "${CONFIG_FILE}"; \
    fi

# Expose Jupyter Lab port
EXPOSE ${JUPYTER_PORT}

# Copy common source code
COPY --chown=${USERNAME}:${USERNAME} bagel/server.py ./bagel/server.py
COPY --chown=${USERNAME}:${USERNAME} bagel/run.py ./bagel/run.py
COPY --chown=${USERNAME}:${USERNAME} bagel/settings.py ./bagel/settings.py
COPY --chown=${USERNAME}:${USERNAME} bagel/__init__.py ./bagel/__init__.py
COPY --chown=${USERNAME}:${USERNAME} bagel/artifacts.py ./bagel/artifacts.py
COPY --chown=${USERNAME}:${USERNAME} bagel/sink/base.py ./bagel/sink/base.py
COPY --chown=${USERNAME}:${USERNAME} bagel/sink/buffer.py ./bagel/sink/buffer.py
COPY --chown=${USERNAME}:${USERNAME} bagel/sink/reader.py ./bagel/sink/reader.py
COPY --chown=${USERNAME}:${USERNAME} bagel/source/base.py ./bagel/source/base.py
COPY --chown=${USERNAME}:${USERNAME} bagel/source/errors.py ./bagel/source/errors.py
COPY --chown=${USERNAME}:${USERNAME} bagel/source/bagel ./bagel/source/bagel
COPY --chown=${USERNAME}:${USERNAME} bagel/source/pyarrow ./bagel/source/pyarrow
COPY --chown=${USERNAME}:${USERNAME} bagel/topic/base.py ./bagel/topic/base.py
COPY --chown=${USERNAME}:${USERNAME} bagel/topic/bagel ./bagel/topic/bagel
COPY --chown=${USERNAME}:${USERNAME} bagel/topic/pyarrow ./bagel/topic/pyarrow
COPY --chown=${USERNAME}:${USERNAME} bagel/message/base.py ./bagel/message/base.py
COPY --chown=${USERNAME}:${USERNAME} bagel/message/bagel ./bagel/message/bagel
COPY --chown=${USERNAME}:${USERNAME} bagel/message/pyarrow ./bagel/message/pyarrow
# MCAP as a first-class format (no ROS required)
COPY --chown=${USERNAME}:${USERNAME} bagel/source/mcap.py ./bagel/source/mcap.py
COPY --chown=${USERNAME}:${USERNAME} bagel/topic/mcap.py ./bagel/topic/mcap.py
COPY --chown=${USERNAME}:${USERNAME} bagel/topic/ros2/definition.py ./bagel/topic/ros2/definition.py
COPY --chown=${USERNAME}:${USERNAME} bagel/topic/ros2/protobuf ./bagel/topic/ros2/protobuf
COPY --chown=${USERNAME}:${USERNAME} bagel/topic/ros2/ros2msg ./bagel/topic/ros2/ros2msg
COPY --chown=${USERNAME}:${USERNAME} bagel/message/mcap.py ./bagel/message/mcap.py
COPY --chown=${USERNAME}:${USERNAME} bagel/message/ros2/convert.py ./bagel/message/ros2/convert.py
COPY --chown=${USERNAME}:${USERNAME} bagel/logging/mcap.py ./bagel/logging/mcap.py
COPY --chown=${USERNAME}:${USERNAME} bagel/logging/base.py ./bagel/logging/base.py
COPY --chown=${USERNAME}:${USERNAME} bagel/pipeline ./bagel/pipeline
COPY --chown=${USERNAME}:${USERNAME} bagel/di ./bagel/di
COPY --chown=${USERNAME}:${USERNAME} bagel/agent ./bagel/agent

# Copy common test code
COPY --chown=${USERNAME}:${USERNAME} test/test_artifacts.py ./test/test_artifacts.py
COPY --chown=${USERNAME}:${USERNAME} test/di ./test/di
COPY --chown=${USERNAME}:${USERNAME} test/source/test_source_base.py ./test/source/test_source_base.py

# Copy configuration file
COPY --chown=${USERNAME}:${USERNAME} .env ./.env

# Copy sample data
COPY --chown=${USERNAME}:${USERNAME} data/sample/ ./data/sample/

# Copy ArduPilot specific source code
COPY --chown=${USERNAME}:${USERNAME} bagel/source/ardupilot ./bagel/source/ardupilot
COPY --chown=${USERNAME}:${USERNAME} bagel/topic/ardupilot ./bagel/topic/ardupilot
COPY --chown=${USERNAME}:${USERNAME} bagel/message/ardupilot ./bagel/message/ardupilot
COPY --chown=${USERNAME}:${USERNAME} bagel/logging/ardupilot ./bagel/logging/ardupilot

# Copy ArduPilot specific test code
COPY --chown=${USERNAME}:${USERNAME} test/source/ardupilot ./test/source/ardupilot
COPY --chown=${USERNAME}:${USERNAME} test/topic/ardupilot ./test/topic/ardupilot
COPY --chown=${USERNAME}:${USERNAME} test/message/ardupilot ./test/message/ardupilot
COPY --chown=${USERNAME}:${USERNAME} test/logging/ardupilot ./test/logging/ardupilot

RUN if [ "_$DEV_MODE" = "_false" ]; then rm -rf ./test ./data; fi

# By default, the Bagel MCP server will be launched
CMD ["uv", "run", "--no-sync", "python", "-m", "bagel.server"]
